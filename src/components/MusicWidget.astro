---
interface Props {
	audioSrc?: string;
	albumSrc?: string;
	albumAlt?: string;
	class?: string;
}

const {
	audioSrc = '/audio/No%20Limits.mp3',
	albumSrc = '/images/album.jpg',
	albumAlt = 'No Limits by Skeler',
	class: className = '',
} = Astro.props;
---

<aside
	id="music-widget"
	class={`music-widget ${className}`.trim()}
	transition:persist="music-player"
	aria-label="Music Player"
>
	<!-- Native Audio Element -->
	<audio
		id="music-audio"
		src={audioSrc}
		preload="metadata"
	></audio>

	<!-- Album Cover, Play/Pause Button, and Top-Left Close Button -->
	<div class="cover-wrapper">
		<!-- Close Button (Positioned at top-left corner of the widget) -->
		<button
			type="button"
			id="music-close-btn"
			class="close-widget-btn"
			aria-label="Close music widget"
		>
			<!-- Close Icon (Lucide x) -->
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="11"
				height="11"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M18 6 6 18"></path>
				<path d="m6 6 12 12"></path>
			</svg>
		</button>

		<div class="cover-disc" id="music-cover-disc">
			<img
				src={albumSrc}
				alt={albumAlt}
				width="48"
				height="48"
				loading="eager"
				decoding="async"
				class="cover-image"
			/>
		</div>

		<!-- Play/Pause Button Overlay (Stays stationary while cover rotates) -->
		<button
			type="button"
			id="music-play-btn"
			class="play-control-btn"
			aria-label="Play music"
		>
			<!-- Play Icon (Lucide play) -->
			<svg
				class="icon-play"
				xmlns="http://www.w3.org/2000/svg"
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="currentColor"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<polygon points="6 3 20 12 6 21 6 3"></polygon>
			</svg>

			<!-- Pause Icon (Lucide pause) -->
			<svg
				class="icon-pause"
				xmlns="http://www.w3.org/2000/svg"
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="currentColor"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<rect x="6" y="4" width="4" height="16"></rect>
				<rect x="14" y="4" width="4" height="16"></rect>
			</svg>
		</button>
	</div>
</aside>

<script>
	type Corner = 'bottom-left' | 'bottom-right' | 'top-right' | 'top-left';

	function setupMusicWidget() {
		const widget = document.getElementById('music-widget');
		if (!widget || widget.dataset.initialized === 'true') return;
		widget.dataset.initialized = 'true';

		const audio = document.getElementById('music-audio') as HTMLAudioElement | null;
		const playBtn = document.getElementById('music-play-btn') as HTMLButtonElement | null;
		const closeBtn = document.getElementById('music-close-btn') as HTMLButtonElement | null;

		if (!audio || !playBtn || !closeBtn) return;

		function updatePlaybackState(isPlaying: boolean) {
			if (!widget || !playBtn) return;
			if (isPlaying) {
				widget.classList.add('is-playing');
				playBtn.setAttribute('aria-label', 'Pause music');
			} else {
				widget.classList.remove('is-playing');
				playBtn.setAttribute('aria-label', 'Play music');
			}
		}

		// --------------------------------------------------
		// Drag & 4-Corner Snapping System
		// --------------------------------------------------
		let currentCorner: Corner = 'bottom-left';
		try {
			const saved = sessionStorage.getItem('music-widget-corner') as Corner | null;
			if (saved && ['bottom-left', 'bottom-right', 'top-right', 'top-left'].includes(saved)) {
				currentCorner = saved;
			}
		} catch (_) {}

		let currentX = 0;
		let currentY = 0;
		let isDragging = false;
		let hasMoved = false;
		let startPointerX = 0;
		let startPointerY = 0;
		let startWidgetX = 0;
		let startWidgetY = 0;
		let justDragged = false;
		let justDraggedTimeout: number | undefined;

		let lastPointerX = 0;
		let lastPointerY = 0;
		let lastTime = 0;
		let velocityX = 0;
		let velocityY = 0;

		function getMargin(): number {
			return window.innerWidth <= 768 ? 16 : 24;
		}

		function getHeaderBottom(): number {
			const header = document.querySelector('.shell-sticky-header') as HTMLElement | null;
			if (header) {
				const rect = header.getBoundingClientRect();
				if (rect.height > 0) {
					return rect.bottom;
				}
			}
			return window.innerWidth <= 768 ? 64 : 72;
		}

		function getCornerCoordinates(corner: Corner): { x: number; y: number } {
			if (!widget) return { x: 24, y: 24 };
			const margin = getMargin();
			const headerBottom = getHeaderBottom();
			const w = widget.offsetWidth || 48;
			const h = widget.offsetHeight || 48;
			const vw = window.innerWidth;
			const vh = window.innerHeight;

			// Top corners always sit below the navigation bar
			const topY = headerBottom + margin;
			const bottomY = Math.max(topY, vh - h - margin);

			switch (corner) {
				case 'top-left':
					return { x: margin, y: topY };
				case 'top-right':
					return { x: Math.max(margin, vw - w - margin), y: topY };
				case 'bottom-right':
					return {
						x: Math.max(margin, vw - w - margin),
						y: bottomY,
					};
				case 'bottom-left':
				default:
					return {
						x: margin,
						y: bottomY,
					};
			}
		}

		function snapToCorner(corner: Corner, animate = true) {
			if (!widget) return;
			currentCorner = corner;
			try {
				sessionStorage.setItem('music-widget-corner', corner);
			} catch (_) {}

			const coords = getCornerCoordinates(corner);
			currentX = coords.x;
			currentY = coords.y;

			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (animate && !prefersReducedMotion) {
				widget.classList.add('is-snapping');
			} else {
				widget.classList.remove('is-snapping');
			}

			widget.style.transform = `translate3d(${coords.x}px, ${coords.y}px, 0)`;
		}

		// Position immediately at active corner
		snapToCorner(currentCorner, false);

		// Pointer Events for Draggable Behavior
		widget.addEventListener('pointerdown', (e) => {
			if (e.button !== 0) return;
			// Close button handles its own click without initiating drag
			if ((e.target as HTMLElement).closest('#music-close-btn')) return;

			isDragging = false;
			hasMoved = false;
			startPointerX = e.clientX;
			startPointerY = e.clientY;
			startWidgetX = currentX;
			startWidgetY = currentY;

			lastPointerX = e.clientX;
			lastPointerY = e.clientY;
			lastTime = performance.now();
			velocityX = 0;
			velocityY = 0;

			widget.setPointerCapture(e.pointerId);
		});

		widget.addEventListener('pointermove', (e) => {
			if (!widget.hasPointerCapture(e.pointerId)) return;

			const dx = e.clientX - startPointerX;
			const dy = e.clientY - startPointerY;

			if (!hasMoved) {
				if (Math.hypot(dx, dy) > 5) {
					hasMoved = true;
					isDragging = true;
					widget.classList.remove('is-snapping');
					widget.classList.add('is-dragging');
				}
			}

			if (isDragging) {
				const now = performance.now();
				const dt = now - lastTime;
				if (dt > 10) {
					velocityX = (e.clientX - lastPointerX) / dt;
					velocityY = (e.clientY - lastPointerY) / dt;
					lastPointerX = e.clientX;
					lastPointerY = e.clientY;
					lastTime = now;
				}

				const margin = 8;
				const headerBottom = getHeaderBottom();
				const w = widget.offsetWidth || 48;
				const h = widget.offsetHeight || 48;
				const minX = margin;
				const maxX = Math.max(margin, window.innerWidth - w - margin);
				// Widget stays below the navigation bar even while dragging
				const minY = headerBottom + margin;
				const maxY = Math.max(minY, window.innerHeight - h - margin);

				currentX = Math.max(minX, Math.min(maxX, startWidgetX + dx));
				currentY = Math.max(minY, Math.min(maxY, startWidgetY + dy));

				widget.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
			}
		});

		function handlePointerEnd(e: PointerEvent) {
			if (!widget || !widget.hasPointerCapture(e.pointerId)) return;
			try {
				widget.releasePointerCapture(e.pointerId);
			} catch (_) {}

			if (isDragging) {
				isDragging = false;
				widget.classList.remove('is-dragging');

				justDragged = true;
				if (justDraggedTimeout) clearTimeout(justDraggedTimeout);
				justDraggedTimeout = window.setTimeout(() => {
					justDragged = false;
				}, 100);

				const w = widget.offsetWidth || 48;
				const h = widget.offsetHeight || 48;
				const centerX = currentX + w / 2;
				const centerY = currentY + h / 2;

				const margin = getMargin();
				const headerBottom = getHeaderBottom();
				const topY = headerBottom + margin;
				const bottomY = Math.max(topY, window.innerHeight - h - margin);
				const verticalMidpoint = (topY + bottomY) / 2;

				let isLeft = centerX < window.innerWidth / 2;
				let isTop = centerY < verticalMidpoint;

				// Subtle velocity-assisted snapping
				if (Math.abs(velocityX) > 0.45) {
					isLeft = velocityX < 0;
				}
				if (Math.abs(velocityY) > 0.45) {
					isTop = velocityY < 0;
				}

				const targetCorner: Corner = isTop
					? (isLeft ? 'top-left' : 'top-right')
					: (isLeft ? 'bottom-left' : 'bottom-right');

				snapToCorner(targetCorner, true);
			}
		}

		widget.addEventListener('pointerup', handlePointerEnd);
		widget.addEventListener('pointercancel', handlePointerEnd);

		widget.addEventListener('transitionend', (e) => {
			if (e.propertyName === 'transform') {
				widget.classList.remove('is-snapping');
			}
		});

		// Keep widget in its corner on window resize or orientation changes
		window.addEventListener('resize', () => {
			if (!isDragging) {
				snapToCorner(currentCorner, false);
			}
		});

		// Observe header size changes (e.g. announcement banner entering after 2s)
		const headerEl = document.querySelector('.shell-sticky-header');
		if (headerEl && typeof ResizeObserver !== 'undefined') {
			const ro = new ResizeObserver(() => {
				if (!isDragging && (currentCorner === 'top-left' || currentCorner === 'top-right')) {
					snapToCorner(currentCorner, true);
				}
			});
			ro.observe(headerEl);
		}

		// Play / Pause toggle
		playBtn.addEventListener('click', async (e) => {
			if (justDragged) {
				e.preventDefault();
				e.stopPropagation();
				return;
			}
			if (audio.paused) {
				try {
					await audio.play();
				} catch (err) {
					console.warn('Playback blocked or failed:', err);
					updatePlaybackState(false);
				}
			} else {
				audio.pause();
			}
		});

		// Drive state directly from native audio events
		audio.addEventListener('play', () => updatePlaybackState(true));
		audio.addEventListener('pause', () => updatePlaybackState(false));
		audio.addEventListener('ended', () => updatePlaybackState(false));

		// Close button removes widget from view
		closeBtn.addEventListener('pointerdown', (e) => {
			e.stopPropagation();
		});

		closeBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			audio.pause();
			widget.style.display = 'none';
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupMusicWidget);
	} else {
		setupMusicWidget();
	}

	document.addEventListener('astro:page-load', setupMusicWidget);
</script>

<style>
	/* --------------------------------------------------
	 * Floating Music Widget Placement
	 * Draggable with snapping to 4 viewport corners
	 * -------------------------------------------------- */
	.music-widget {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 9999;
		display: block;
		user-select: none;
		touch-action: none;
		cursor: grab;
		/* Initial fallback before hydration: bottom-left */
		transform: translate3d(24px, calc(100vh - 48px - 24px), 0);
		transform: translate3d(24px, calc(100dvh - 48px - 24px), 0);
		will-change: transform;
	}

	@media (max-width: 768px) {
		.music-widget {
			transform: translate3d(16px, calc(100vh - 48px - 16px), 0);
			transform: translate3d(16px, calc(100dvh - 48px - 16px), 0);
		}
	}

	.music-widget.is-dragging {
		cursor: grabbing;
		transition: none !important;
	}

	.music-widget.is-snapping {
		transition: transform 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.15);
	}

	.music-widget.is-dragging .cover-wrapper {
		transform: scale(1.08);
	}

	.music-widget.is-dragging .cover-disc {
		box-shadow:
			0 14px 28px rgba(0, 0, 0, 0.75),
			0 0 0 1.5px rgba(255, 255, 255, 0.22);
	}

	/* --------------------------------------------------
	 * Album Cover & Rotating Disc
	 * -------------------------------------------------- */
	.cover-wrapper {
		position: relative;
		width: 48px;
		height: 48px;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.2s ease;
	}

	.cover-disc {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		overflow: hidden;
		background-color: #121212;
		box-shadow:
			0 4px 16px rgba(0, 0, 0, 0.55),
			0 0 0 1px rgba(255, 255, 255, 0.12);
		animation: music-spin 14s linear infinite;
		animation-play-state: paused;
		will-change: transform;
	}

	.music-widget.is-playing .cover-disc {
		animation-play-state: running;
	}

	@keyframes music-spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	.cover-image {
		width: 100%;
		height: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		display: block;
		pointer-events: none;
	}

	/* --------------------------------------------------
	 * Play / Pause Overlay Button
	 * Stays stationary and upright over rotating cover
	 * -------------------------------------------------- */
	.play-control-btn {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		border: none;
		background-color: rgba(0, 0, 0, 0.42);
		backdrop-filter: blur(1.5px);
		color: #ffffff;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background-color 0.2s ease;
		padding: 0;
		z-index: 2;
	}

	.play-control-btn:hover {
		background-color: rgba(0, 0, 0, 0.26);
	}

	.play-control-btn:focus-visible {
		outline: 2px solid var(--color-accent, #FF6E4E);
		outline-offset: 2px;
	}

	.icon-play {
		display: block;
		margin-left: 2px; /* optical center for triangle */
	}

	.icon-pause {
		display: none;
	}

	.music-widget.is-playing .icon-play {
		display: none;
	}

	.music-widget.is-playing .icon-pause {
		display: block;
	}

	/* --------------------------------------------------
	 * Close Button (Top-Left Corner of Widget)
	 * -------------------------------------------------- */
	.close-widget-btn {
		position: absolute;
		top: -4px;
		left: -4px;
		width: 18px;
		height: 18px;
		border-radius: 9999px;
		border: 1px solid #333333;
		background-color: #141414;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.75);
		color: #a3a3a3;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		z-index: 10;
		transition:
			color 0.15s ease,
			background-color 0.15s ease,
			border-color 0.15s ease,
			transform 0.15s ease;
	}

	.close-widget-btn:hover {
		color: #ffffff;
		background-color: #242424;
		border-color: #555555;
		transform: scale(1.1);
	}

	.close-widget-btn:focus-visible {
		outline: 2px solid var(--color-accent, #FF6E4E);
		outline-offset: 2px;
	}

	/* --------------------------------------------------
	 * Reduced Motion
	 * -------------------------------------------------- */
	@media (prefers-reduced-motion: reduce) {
		.cover-disc {
			animation: none !important;
		}
		.music-widget.is-snapping {
			transition: none !important;
		}
		.cover-wrapper {
			transition: none !important;
		}
	}
</style>
